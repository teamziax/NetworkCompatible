{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent.warden.cloud/schemas/provider-registration-v0.json",
  "title": "nethernet-provider-registration-v0",
  "type": "object",
  "required": [
    "protocol",
    "mode",
    "profile",
    "publicKeyJwk"
  ],
  "properties": {
    "protocol": {
      "const": "nethernet-provider-registration-v0"
    },
    "mode": {
      "enum": [
        "new-service",
        "attach-instance"
      ]
    },
    "profile": {
      "type": "string"
    },
    "publicKeyJwk": {
      "type": "object",
      "required": [
        "crv",
        "kty",
        "x",
        "y"
      ],
      "not": {
        "required": [
          "d"
        ]
      },
      "properties": {
        "crv": {
          "const": "P-384"
        },
        "kty": {
          "const": "EC"
        },
        "x": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{64}$"
        },
        "y": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{64}$"
        }
      }
    },
    "label": {
      "type": "string",
      "maxLength": 128
    },
    "bootstrapGrant": {
      "type": "string"
    },
    "authorization": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scheme"
      ],
      "properties": {
        "scheme": {
          "enum": [
            "anonymous-proof-of-work",
            "bearer-token",
            "bootstrap-grant"
          ]
        }
      }
    },
    "placement": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "region",
        "pool"
      ],
      "properties": {
        "region": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,32}$"
        },
        "pool": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_-]{1,64}$"
        },
        "tags": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[A-Za-z0-9_.-]{1,32}$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "maxProperties": 16
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "mode": {
            "const": "attach-instance"
          }
        }
      },
      "then": {
        "required": [
          "placement"
        ],
        "anyOf": [
          {
            "required": [
              "bootstrapGrant"
            ]
          },
          {
            "required": [
              "authorization"
            ],
            "properties": {
              "authorization": {
                "properties": {
                  "scheme": {
                    "const": "bearer-token"
                  }
                }
              }
            }
          }
        ]
      }
    }
  ],
  "$defs": {
    "discovery": {
      "type": "object",
      "required": [
        "provider",
        "controlOrigin",
        "protocols",
        "signatures",
        "modes",
        "profiles",
        "operations",
        "policy",
        "authorization",
        "limits"
      ],
      "properties": {
        "authorization": {
          "type": "object",
          "required": [
            "header",
            "schemes"
          ],
          "properties": {
            "header": {
              "const": "Authorization"
            },
            "schemes": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "scheme",
                  "modes"
                ],
                "properties": {
                  "scheme": {
                    "enum": [
                      "anonymous-proof-of-work",
                      "bearer-token",
                      "bootstrap-grant"
                    ]
                  },
                  "modes": {
                    "type": "array",
                    "items": {
                      "enum": [
                        "new-service",
                        "attach-instance"
                      ]
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "challenge": {
      "type": "object",
      "required": [
        "protocol",
        "signature",
        "challengeId",
        "nonce",
        "audience",
        "thumbprint",
        "context",
        "contextDigest",
        "expiresAt",
        "serverTime",
        "pow"
      ],
      "properties": {
        "protocol": {
          "const": "nethernet-provider-registration-v0"
        },
        "signature": {
          "const": "provider-es384-v0"
        },
        "expiresAt": {
          "type": "integer"
        },
        "serverTime": {
          "type": "integer"
        },
        "authorization": {
          "type": "object",
          "required": [
            "scheme",
            "reference"
          ],
          "properties": {
            "scheme": {
              "enum": [
                "anonymous-proof-of-work",
                "bearer-token",
                "bootstrap-grant"
              ]
            },
            "reference": {
              "type": "string"
            }
          }
        }
      }
    },
    "completion": {
      "type": "object",
      "required": [
        "protocol",
        "challengeId",
        "proofNonce",
        "signature",
        "idempotencyKey"
      ],
      "properties": {
        "protocol": {
          "const": "nethernet-provider-registration-v0"
        }
      }
    },
    "registration": {
      "type": "object",
      "required": [
        "protocol",
        "provider",
        "registrationId",
        "serviceId",
        "instanceId",
        "keyId",
        "profile",
        "publicAddress",
        "placement",
        "heartbeatIntervalMs",
        "leaseGeneration",
        "leaseDeadline",
        "readiness"
      ],
      "properties": {
        "protocol": {
          "const": "nethernet-provider-registration-v0"
        }
      }
    },
    "readiness": {
      "type": "object",
      "required": [
        "serverTime",
        "serviceId",
        "instanceId",
        "serviceAvailable",
        "instanceRoutable",
        "readiness",
        "leaseGeneration",
        "leaseDeadline",
        "placement"
      ]
    },
    "activation": {
      "type": "object",
      "required": [
        "accepted",
        "serverTime",
        "leaseGeneration",
        "leaseDeadline",
        "readiness"
      ]
    },
    "rotation": {
      "type": "object",
      "required": [
        "publicKeyJwk",
        "proof"
      ]
    },
    "ticketKey": {
      "type": "object",
      "required": [
        "keyId",
        "secret"
      ]
    },
    "pendingAction": {
      "type": "object",
      "required": [
        "url",
        "expiresAt",
        "text"
      ]
    }
  },
  "x-context-order": [
    "mode",
    "profile",
    "label",
    "grantId",
    "serviceId",
    "region",
    "pool",
    "registrationId"
  ],
  "x-optional-context-order": [
    "tagsDigest"
  ],
  "x-signature-format": "ES384 P1363 r||s 96 bytes unpadded base64url",
  "x-canonicalization": "UTF-8 JSON arrays, no whitespace, no Unicode normalization, epoch milliseconds as integers, absent context strings are empty"
}
